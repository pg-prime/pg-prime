node_modules/
dist/
coverage/
*.tsbuildinfo
.DS_Store
*.log

# generated type-bench scenarios
bench/types/.gen/

# stray declaration emit inside src (never checked in; `dist/` is the real output)
packages/*/src/**/*.d.ts
# ...except the one hand-written (generated, but by tools/api-snapshot.mjs, not by tsc) declaration
# file: the `types@<5.9` gate of design/08 §2.2. tsc never emits it and never copies it;
# tools/build-package.mjs copies it into dist/, and the export map points every subpath at it.
!packages/*/src/unsupported-typescript.d.ts

# The scaffolder's dependency pins, generated from the workspace's own package.json files by
# packages/pg-prime-create/scripts/versions.mjs (design/13 decision 6: a scaffolder pins what it
# scaffolds, and a pin read at build time cannot rot). `build`, `typecheck` and the vitest global
# setup each run the generator first, so a fresh checkout never misses it.
packages/pg-prime-create/src/versions.ts

# The end-to-end loop test's scratch project. It lives inside the package rather than in
# os.tmpdir() so that `import { pgTable } from 'pg-prime'` in the generated schema module
# resolves through the workspace's node_modules, exactly as a user's project does.
packages/pg-prime-kit/.e2e/

# IDE state
.idea/

# generated runtime-bench build (packages/pg-prime emitted for the bench to import)
bench/runtime/.gen/

# Agent worktrees (Claude Code) — never part of the repo
.claude/worktrees/
# ad-hoc CPU profiles from `pnpm bench:profile --cpu`
*.cpuprofile

# `pnpm pack` output. tools/pack-smoke.mjs and tools/size-budget.mjs pack into os.tmpdir() and
# `attw --pack` deletes its own tarball, so nothing should land here — this is the safety net for
# the run that was interrupted, and for a hand-run `pnpm pack`.
*.tgz
