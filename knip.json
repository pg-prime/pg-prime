{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "exclude": ["exports", "types", "nsExports", "nsTypes", "duplicates"],
  "workspaces": {
    ".": {
      "entry": ["tools/*.mjs"],
      "project": ["tools/**/*.mjs"],
      "ignoreDependencies": ["@arethetypeswrong/cli", "publint", "pg"]
    },
    "packages/pg-prime": {
      "entry": [
        "src/query/types.ts",
        "src/driver/index.ts",
        "test/**/*.test.ts",
        "test/**/*.probe.ts",
        "test/**/_globalSetup.ts",
        "test/**/_setup.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/pg-prime-kit": {
      "entry": ["src/index.ts", "src/cli.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/pg-prime-create": {
      "entry": ["src/index.ts", "src/cli.ts", "test/**/*.test.ts", "test/**/globalSetup.ts"],
      "project": ["src/**/*.ts", "scripts/*.mjs", "test/**/*.ts"],
      "ignore": ["templates/**"]
    },
    "bench/runtime": {
      "entry": ["run.mjs", "profile.mjs", "statement.mjs"],
      "project": ["**/*.mjs"]
    },
    "bench/compare": {
      "entry": ["run.mjs"],
      "project": ["**/*.mjs"]
    },
    "bench/types": {
      "entry": ["arms/*.ts"],
      "project": ["**/*.mjs", "**/*.ts"]
    },
    "docs": {
      "entry": ["src/snippets/**/*.ts"],
      "project": ["**/*.{ts,mjs}"],
      "ignoreDependencies": ["@pg-prime/kit", "@electric-sql/pglite"]
    }
  },
  "rules": {
    "optionalPeerDependencies": "off"
  }
}
