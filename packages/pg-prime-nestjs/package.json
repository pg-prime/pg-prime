{
  "name": "@pg-prime/nestjs",
  "version": "0.2.0",
  "description": "NestJS module for pg-prime: the configured Db, ambient transactions, @Transactional(), request settings and rollback-per-test. Pre-alpha — the API will change.",
  "keywords": [
    "nest",
    "nestjs",
    "pg-prime",
    "postgres",
    "postgresql",
    "transactional"
  ],
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pg-prime/pg-prime.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types@<5.9": "./dist/unsupported-typescript.d.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types@<5.9": "./dist/unsupported-typescript.d.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../tools/build-package.mjs",
    "clean": "node ../../tools/build-package.mjs --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:live": "vitest run --project unit --project live",
    "test:pg": "vitest run"
  },
  "dependencies": {
    "@pg-prime/context": "workspace:^"
  },
  "devDependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14.0.3",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/testing": "^12.1.2",
    "@pg-prime/testing": "workspace:*",
    "graphql": "^16.14.2",
    "pg-prime": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "pg-prime": ">=0.2.0",
    "rxjs": "^7.8.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
