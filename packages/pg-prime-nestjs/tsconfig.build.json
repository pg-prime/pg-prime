{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedDeclarations": true,
    "noEmit": false,
    "experimentalDecorators": false,
    "emitDecoratorMetadata": false,
    "types": ["node"],
    "paths": {}
  },
  "include": ["src"]
}
