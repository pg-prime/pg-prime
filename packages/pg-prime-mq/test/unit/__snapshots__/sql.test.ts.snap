m.claims, m.retry, m.token, m.progress, m.result, m.error, m.parent, m.on_fail, m.pending_deps, m.cancel, m.child_failed, m.created_at, m.started_at, m.finished_at), gu as (update "pgprime_mq"."groups" r set active = r.active + c.n, rate_window = case when g.fresh then now() else r.rate_window end, rate_count = g.used + c.n, limited_until = case when g.rmax <= g.used + c.n then coalesce(case when g.fresh then now() end, r.rate_window) + g.rms * interval '1 ms' else r.limited_until end from (select group_key, count(*)::int as n from up group by 1) c join g on g.key = c.group_key where r.queue = $21 and r.key = c.group_key), up_ev as (select pg_notify(('ev_' || left(encode(sha256(convert_to($22::text || (up.queue)::text, 'UTF8')), 'hex'), 24)), json_build_object('id', up.id::text, 's', up.state)::text) from up join "pgprime_mq"."queues" wq on wq.name = up.queue where wq.watch and true) select meta.*, up.id, up.queue, up.state, up.payload, up.key, up.priority, up.order_key, up.run_at, up.group_key, up.attempts, up.claims, up.retry, up.token, up.progress, up.result, up.error, up.parent, up.on_fail, up.pending_deps, up.cancel, up.child_failed, up.created_at, up.started_at, up.finished_at from (select coalesce((select max(group_key) from up), (select max(k) from cand)) as cursor, (select count(*)::int from cand) as scanned, (select count(*) from up_ev) as fx) meta left join up on true

-- claim limited=true
with q as (select name, rate_max, rate_ms, concurrency, active, (rate_window is null or rate_window + rate_ms * interval '1 ms' <= now()) as fresh, case when rate_window is null or rate_window + rate_ms * interval '1 ms' <= now() then 0 else rate_count end as used from "pgprime_mq"."queues" where name = $1 and not paused and coalesce(limited_until, '-infinity') <= now() for update), next as (select id from "pgprime_mq"."messages" where queue = $2 and state = 'ready' and group_key is null order by priority, order_key limit coalesce((select greatest(0, least($3::int, coalesce(rate_max - used, $4::int), coalesce(concurrency - active, $5::int))) from q), 0) for update skip locked), up as (update "pgprime_mq"."messages" m set state = 'active', token = coalesce($6::text, gen_random_uuid()::text), lease_until = now() + $7::float8 * interval '1 ms', consumer = $8, started_at = clock_timestamp(), claims = m.claims + 1, counted = (select concurrency is not null from q) from next where m.id = next.id returning m.id, m.queue, m.state, m.payload, m.key, m.priority, m.order_key, m.run_at, m.group_key, m.attempts, m.claims, m.retry, m.token, m.progress, m.result, m.error, m.parent, m.on_fail, m.pending_deps, m.cancel, m.child_failed, m.created_at, m.started_at, m.finished_at), qu as (update "pgprime_mq"."queues" u set rate_window = case when q.fresh then now() else u.rate_window end, rate_count = q.used + c.n, active = u.active + case when u.concurrency is null then 0 else c.n end, limited_until = case when q.rate_max <= q.used + c.n then coalesce(case when q.fresh then now() end, u.rate_window) + q.rate_ms * interval '1 ms' else u.limited_until end from q, (select count(*)::int as n from up) c where u.name = q.name and c.n > 0), up_ev as (select pg_notify(('ev_' || left(encode(sha256(convert_to($9::text || (up.queue)::text, 'UTF8')), 'hex'), 24)), json_build_object('id', up.id::text, 's', up.state)::text) from up join "pgprime_mq"."queues" wq on wq.name = up.queue where wq.watch and true) select up.id, up.queue, up.state, up.payload, up.key, up.priority, up.order_key, up.run_at, up.group_key, up.attempts, up.claims, up.retry, up.token, up.progress, up.result, up.error, up.parent, up.on_fail, up.pending_deps, up.cancel, up.child_failed, up.created_at, up.started_at, up.finished_at, (select count(*) from up_ev) as fx from up

-- claim-groups limited=true
with recursive keys(k) as ((select group_key from "pgprime_mq"."messages" where queue = $1 and state = 'ready' and group_key > $2 order by group_key limit 1) union all select (select m.group_key from "pgprime_mq"."messages" m where m.queue = $3 and m.state = 'ready' and m.group_key > keys.k order by m.group_key limit 1) from keys where keys.k is not null), cand as (select k from keys where k is not null limit $4::int), q as (select name, rate_max, rate_ms, concurrency, active, (rate_window is null or rate_window + rate_ms * interval '1 ms' <= now()) as fresh, case when rate_window is null or rate_window + rate_ms * interval '1 ms' <= now() then 0 else rate_count end as used from "pgprime_mq"."queues" where name = $5 and not paused and coalesce(limited_until, '-infinity') <= now() for update), g as (select key, (rate_window is null or rate_window + coalesce(rate_ms, $6::int) * interval '1 ms' <= now()) as fresh, coalesce(rate_max, $7::int) as rmax, coalesce(rate_ms, $8::int) as rms, case when (rate_window is null or rate_window + coalesce(rate_ms, $9::int) * interval '1 ms' <= now()) then 0 else rate_count end as used, least(coalesce(concurrency, $10::int) - active, coalesce(coalesce(rate_max, $11::int) - case when (rate_window is null or rate_window + coalesce(rate_ms, $12::int) * interval '1 ms' <= now()) then 0 else rate_count end, $13::int)) as free from "pgprime_mq"."groups" where queue = $14 and key in (select k from cand) and not paused and active < coalesce(concurrency, $15::int) and coalesce(limited_until, '-infinity') <= now() order by key for update skip locked), pick as (select c.id from g cross join lateral ( select id from "pgprime_mq"."messages" m where m.queue = $16 and m.group_key = g.key and m.state = 'ready' order by priority, order_key limit greatest(g.free, 0) for update skip locked) c limit coalesce((select greatest(0, least($17::int, coalesce(rate_max - used, $18::int), coalesce(concurrency - active, $19::int))) from q), 0)), up as (update "pgprime_mq"."messages" m set state = 'active', token = coalesce($20::text, gen_random_uuid()::text), lease_until = now() + $21::float8 * interval '1 ms', consumer = $22, started_at = clock_timestamp(), claims = m.claims + 1, counted = (select concurrency is not null from q) from pick where m.id = pick.id returning m.id, m.queue, m.state, m.payload, m.key, m.priority, m.order_key, m.run_at, m.group_key, m.attempts, m.claims, m.retry, m.token, m.progress, m.result, m.error, m.parent, m.on_fail, m.pending_deps, m.cancel, m.child_failed, m.created_at, m.started_at, m.finished_at), gu as (update "pgprime_mq"."groups" r set active = r.active + c.n, rate_window = case when g.fresh then now() else r.rate_window end, rate_count = g.used + c.n, limited_until = case when g.rmax <= g.used + c.n then coalesce(case when g.fresh then now() end, r.rate_window) + g.rms * interval '1 ms' else r.limited_until end from (select group_key, count(*)::int as n from up group by 1) c join g on g.key = c.group_key where r.queue = $23 and r.key = c.group_key), qu as (update "pgprime_mq"."queues" u set rate_window = case when q.fresh then now() else u.rate_window end, rate_count = q.used + c.n, active = u.active + case when u.concurrency is null then 0 else c.n end, limited_until = case when q.rate_max <= q.used + c.n then coalesce(case when q.fresh then now() end, u.rate_window) + q.rate_ms * interval '1 ms' else u.limited_until end from q, (select count(*)::int as n from up) c where u.name = q.name and c.n > 0), up_ev as (select pg_notify(('ev_' || left(encode(sha256(convert_to($24::text || (up.queue)::text, 'UTF8')), 'hex'), 24)), json_build_object('id', up.id::text, 's', up.state)::text) from up join "pgprime_mq"."queues" wq on wq.name = up.queue where wq.watch and true) select meta.*, up.id, up.queue, up.state, up.payload, up.key, up.priority, up.order_key, up.run_at, up.group_key, up.attempts, up.claims, up.retry, up.token, up.progress, up.result, up.error, up.parent, up.on_fail, up.pending_