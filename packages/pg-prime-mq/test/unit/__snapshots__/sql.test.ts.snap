-- send no-notify
with src as (select nextval($1::regclass) as id, r.* from rows from (jsonb_to_recordset($2::jsonb) as ( n int, queue text, parent_n int, kids int, on_fail text, payload jsonb, key text, priority int, lifo boolean, delay_ms float8, run_at timestamptz, group_key text, retry jsonb, dedup text, dedup_ms float8)) r order by r.n), ins as (insert into "pgprime_mq"."messages" (id, queue, state, payload, key, priority, order_key, run_at, group_key, retry, dedup_key, parent, on_fail, pending_deps) select s.id, s.queue, (case when s.kids > 0 then 'blocked' when s.at > now() then 'delayed' else 'ready' end)::"pgprime_mq"."msg_state", coalesce(s.payload, 'null'::jsonb), s.key, s.priority, case when s.lifo then -s.id else s.id end, case when s.kids = 0 and s.at > now() then s.at end, s.group_key, s.retry, s.dedup, p.id, s.on_fail::"pgprime_mq"."on_fail", s.kids from (select src.*, coalesce(run_at, now() + delay_ms * interval '1 ms') as at from src) s left join src p on p.n = s.parent_n where true returning id, queue, state, group_key, parent), dps as (insert into "pgprime_mq"."deps" (parent, child, child_queue) select parent, id, queue from ins where parent is not null), grp as (insert into "pgprime_mq"."groups" (queue, key) select distinct queue, group_key from ins where group_key is not null on conflict do nothing), ins_ev as (select pg_notify(('ev_' || left(encode(sha256(convert_to($3::text || (ins.queue)::text, 'UTF8')), 'hex'), 24)), json_build_object('id', ins.id::text, 's', ins.state)::text) from ins join "pgprime_mq"."queues" wq on wq.name = ins.queue where wq.watch and true) select src.n, ins.id, null::bigint as existing, (select count(*) from ins_ev) as fx from src left join ins on ins.id = src.id order by src.n

-- flow dedup root
with src as (select nextval($1::regclass) as id, r.* from rows from (jsonb_to_recordset($2::jsonb) as ( n int, queue text, parent_n int, kids int, on_fail text, payload jsonb, key text, priority int, lifo boolean, delay_ms float8, run_at timestamptz, group_key text, retry jsonb, dedup text, dedup_ms float8)) r order by r.n), d as (insert into "pgprime_mq"."dedup" as x (queue, key, msg, expire_at) select queue, dedup, id, now() + dedup_ms * interval '1 ms' from src where dedup is not null on conflict (queue, key) do update set msg = case when x.expire_at <= now() then excluded.msg else x.msg end, expire_at = excluded.expire_at where x.expire_at <= now() or (excluded.expire_at is not null and $3::boolean) returning key, msg), ins as (insert into "pgprime_mq"."messages" (id, queue, state, payload, key, priority, order_key, run_at, group_key, retry, dedup_key, parent, on_fail, pending_deps) select s.id, s.queue, (case when s.kids > 0 then 'blocked' when s.at > now() then 'delayed' else 'ready' end)::"pgprime_mq"."msg_state", coalesce(s.payload, 'null'::jsonb), s.key, s.priority, case when s.lifo then -s.id else s.id end, case when s.kids = 0 and s.at > now() then s.at end, s.group_key, s.retry, s.dedup, p.id, s.on_fail::"pgprime_mq"."on_fail", s.kids from (select src.*, coalesce(run_at, now() + delay_ms * interval '1 ms') as at from src) s left join src p on p.n = s.parent_n where true and (s.dedup is null or exists (select from d where d.key = s.dedup and d.msg = s.id)) and not exists (select from src s where s.dedup is not null and not exists (select from d where d.key = s.dedup and d.msg = s.id)) returning id, queue, state, group_key, parent), dps as (insert into "pgprime_mq"."deps" (parent, child, child_queue) select parent, id, queue from ins where parent is not null), grp as (insert into "pgprime_mq"."groups" (queue, key) select distinct queue, group_key from ins where group_key is not null on conflict do nothing), ins_wk as (select pg_notify(('ev_' || left(encode(sha256(convert_to($4::text || (w.queue)::text, 'UTF8')), 'hex'), 24)), 'w') from (select distinct queue from ins where state <> 'blocked') w), ins_ev as (select pg_notify(('ev_' || left(encode(sha256(convert_to($5::text || (ins.queue)::text, 'UTF8')), 'hex'), 24)), json_build_object('id', ins.id::text, 's', ins.state)::text) from ins join "pgprime_mq"."queues" wq on wq.name = ins.queue where wq.watch and true) select src.n, ins.id, d.msg as existing, (select count(*) from ins_wk) + (select count(*) from ins_ev) as fx from src left join ins on ins.id = src.id left join d on d.key = src.dedup and d.msg <> src.id order by src.n

-- spawn
with src as (select nextval($1::regclass) as id, r.* from rows from (jsonb_to_recordset($2::jsonb) as ( n int, queue text, parent_n int, kids int, on_fail text, payload jsonb, key text, priority int, lifo boolean, delay_ms float8, run_at timestamptz, group_key text, retry jsonb, dedup text, dedup_ms float8)) r order by r.n), par as (update "pgprime_mq"."messages" set pending_deps = pending_deps + $3::int where id = $4::bigint and token = $5 and state = 'active' returning id), ins as (insert into "pgprime_mq"."messages" (id, queue, state, payload, key, priority, order_key, run_at, group_key, retry, dedup_key, parent, on_fail, pending_deps) select s.id, s.queue, (case when s.kids > 0 then 'blocked' when s.at > now() then 'delayed' else 'ready' end)::"pgprime_mq"."msg_state", coalesce(s.payload, 'null'::jsonb), s.key, s.priority, case when s.lifo then -s.id else s.id end, case when s.kids = 0 and s.at > now() then s.at end, s.group_key, s.retry, s.dedup, $6::bigint, s.on_fail::"pgprime_mq"."on_fail", s.kids from (select src.*, coalesce(run_at, now() + delay_ms * interval '1 ms') as at from src) s left join src p on p.n = s.parent_n where true and exists (select from par) returning id, queue, state, group_key, parent), dps as (insert into "pgprime_mq"."deps" (parent, child, child_queue) select parent, id, queue from ins where parent is not null), grp as (insert into "pgprime_mq"."groups" (queue, key) select distinct queue, group_key from ins where group_key is not null on conflict do nothing), ins_wk as (select pg_notify(('ev_' || left(encode(sha256(convert_to($7::text || (w.queue)::text, 'UTF8')), 'hex'), 24)), 'w') from (select distinct queue from ins where state <> 'blocked') w), ins_ev as (select pg_notify(('ev_' || left(encode(sha256(convert_to($8::text || (ins.queue)::text, 'UTF8')), 'hex'), 24)), json_build_object('id', ins.id::text, 's', ins.state)::text) from ins join "pgprime_mq"."queues" wq on wq.name = ins.queue where wq.watch and true) select src.n, ins.id, null::bigint as existing, (select count(*) from ins_wk) + (select count(*) from ins_ev) as fx from src left join ins on ins.id = src.id order by src.n

-- promote due
with due as (select id from "pgprime_mq"."messages" where queue = $1 and state = 'delayed' and run_at <= now() order by run_at limit 1000 for update skip locked), up as (update "pgprime_mq"."messages" m set state = 'ready', run_at = null, order_key = sign(m.order_key) * nextval($2::regclass) from due where m.id = due.id returning m.id, m.queue, m.state), up_wk as (select pg_notify(('ev_' || left(encode(sha256(convert_to($3::text || (w.queue)::text, 'UTF8')), 'hex'), 24)), 'w') from (select distinct queue from up where true) w), up_ev as (select pg_notify(('ev_' || left(encode(sha256(convert_to($4::text || (up.queue)::text, 'UTF8')), 'hex'), 24)), json_build_object('id', up.id::text, 's', up.state)::text) from up join "pgprime_mq"."queues" wq on wq.name = up.queue where wq.watch and true) select (select count(*)::int from up) as promoted, (select count(*) from up_wk) + (select count(*) from up_ev) as fx, greatest(0, extract(epoch from (select min(run_at) from "pgprime_mq"."messages" where queue = $5 and state = 'delayed' and run_at > now()) - now()) * 1000)::float8 as next_in

-- promote one
with due as (select id from "pgprime_mq"."messages" where queue = $1 and state = 'delayed' and id = $2::bigint order by run_at limit 1000 for update skip locked), up as (update "pgprime_mq"."messages" m set state = 'ready', run_at = null, order_key = sign(m.order_key) * nextval($3::regclass) from due where m.id = due.id returning m.id, m.queue, m.state), up_wk as (select pg_notify(('ev_' || left(encode(sha256(convert_to($4::text || (w.queue)::text, 'UTF8')), 'hex'), 24)), 'w') from (select distinct queue from up where true) w), up_ev as (select pg_notify(('ev_' || left(encode(sha256(convert_to($5::text || (up.queue)::text, 'UTF8')), 'hex'), 24)), json_build_object('id', up.id::text, 's', up.state)::text) from up join "pgprime_mq"."queues" wq on wq.name = up.queue where wq.watch and true) select (select count(*)::int from up) as promoted, (select count(*) from up_wk) + (select count(*) from up_ev) as fx, greatest(0, extract(epoch from (select min(run_at) from "pgprime_mq"."messages" where queue = $6 and state = 'delayed' and run_at > now()) - now()) * 1000)::float8 as next_in

-- expire
with x as (select id, attempts, (retry->>'maxAttempts')::int as max_attempts from "pgprime_mq"."messages" where queue = $1 and state = 'active' and lease_until < now() for update skip locked), done as (update "pgprime_mq"."messages" m set attempts = m.attempts + 1, state = 'delayed', run_at = now() + (case m.retry->>'jitter' when 'none' then 1.0 when 'equal' then 0.5 + random() / 2 else random() end) * least((m.retry->>'maxDelayMs')::float8, (m.retry->>'baseDelayMs')::float8 * 2 ^ (m.attempts)) * interval '1 ms', order_key = sign(m.order_key) * nextval($2::regclass), error = 'lease-expired', stack = null, token = null, lease_until = null from x where m.id = x.id and x.attempts + 1 < x.max_attempts returning m.id, m.queue, m.state, m.group_key, m.counted), gd as (update "pgprime_mq"."groups" g set active = g.active - c.n from (select group_key, count(*)::int as n from done where group_key is not null group by 1) c where g.queue = $3 and g.key = c.group_key returning g.queue), qd as (update "pgprime_mq"."queues" u set active = u.active - c.n from (select count(*)::int as n from done where counted) c where u.name = $4 and c.n > 0 and (select count(*) from gd) >= 0 returning u.name as queue), done_wk as (select pg_notify(('ev_' || left(encode(sha256(convert_to($5::text || (w.queue)::text, 'UTF8')), 'hex'), 24)), 'w') from (select distinct queue from done where true) w), done_ev as (select pg_notify(('ev_' || left(encode(sha256(convert_to($6::text || (done.queue)::text, 'UTF8')), 'hex'), 24)), json_build_object('id', done.id::text, 's', done.state)::text) from done join "pgprime_mq"."queues" wq on wq.name = done.queue where wq.watch and true) select (select array_agg(id order by id) from done) as requeued, (select array_agg(id order by id) from x where attempts + 1 >= max_attempts) as exhausted, (select count(*) from done_wk) + (select count(*) from done_ev) as fx

-- retry ids
with sel as (select m.id from "pgprime_mq"."messages" m where m.queue = $1 and m.state in ('completed', 'failed', 'cancelled') and m.id = any($2::bigint[]) and not exists (select from "pgprime_mq"."deps" d where d.parent = m.id and d.status in ('pending', 'failed')) order by m.id limit $3::int for update skip locked), up as (update "pgprime_mq"."messages" m set state = 'ready', run_at = null, order_key = sign(m.order_key) * nextval($4::regclass), attempts = 0, expire_at = null, finished_at = null, started_at = null, result = null, error = null, stack = null, progress = null, cancel = false, child_failed = false, token = null, lease_until = null from sel where m.id = sel.id returning m.id, m.queue, m.state, m.parent), dr as (update "pgprime_mq"."deps" d set status = 'pending', value = null from up where d.parent = up.parent and d.child = up.id and d.status = 'failed'), up_wk as (select pg_notify(('ev_' || left(encode(sha256(convert_to($5::text || (w.queue)::text, 'UTF8')), 'hex'), 24)), 'w') from (select distinct queue from up where true) w), up_ev as (select pg_notify(('ev_' || left(encode(sha256(convert_to($6::text || (up.queue)::text, 'UTF8')), 'hex'), 24)), json_build_object('id', up.id::text, 's', up.state)::text) from up join "pgprime_mq"."queues" wq on wq.name = up.queue where wq.watch and true) select (select count(*)::int from up) as n, (select count(*) from up_wk) + (select count(*) from up_ev) as fx

-- retry state
with sel as (select m.id from "pgprime_mq"."messages" m where m.queue = $1 and m.state in ('completed', 'failed', 'cancelled') and m.state = $2::"pgprime_mq"."msg_state" and not exists (select from "pgprime_mq"."deps" d where d.parent = m.id and d.status in ('pending', 'failed')) order by m.id limit $3::int for update skip locked), up as (update "pgprime_mq"."messages" m set state = 'ready', run_at = null, order_key = sign(m.order_key) * nextval($4::regclass), attempts = 0, expire_at = null, finished_at = null, started_at = null, result = null, error = null, stack = null, progress = null, cancel = false, child_failed = false, token = null, lease_until = null from sel where m.id = sel.id returning m.id, m.queue, m.state, m.parent), dr as (update "pgprime_mq"."deps" d set status = 'pending', value = null from up where d.parent = up.parent and d.child = up.id and d.status = 'failed'), up_wk as (select pg_notify(('ev_' || left(encode(sha256(convert_to($5::text || (w.queue)::text, 'UTF8')), 'hex'), 24)), 'w') from (select distinct queue from up where true) w), up_ev as (select pg_notify(('ev_' || left(encode(sha256(convert_to($6::text || (up.queue)::text, 'UTF8')), 'hex'), 24)), json_build_object('id', up.id::text, 's', up.state)::text) from up join "pgprime_mq"."queues" wq on wq.name = up.queue where wq.watch and true) select (select count(*)::int from up) as n, (select count(*) from up_wk) + (select count(*) from up_ev) as fx"
`;

exports[`statements > match the golden SQL, labelled mq.<op> 2`] = `
"-- mq.mq.heartbeat
with h as ( select m.id from "pgprime_mq"."messages" m join unnest($1::bigint[], $2::text[]) as k(id, token) on m.id = k.id and m.token = k.token where m.state = 'active' for update of m skip locked ) update "pgprime_mq"."messages" m set lease_until = now() + $3::float8 * interval '1 ms' from h where m.id = h.id returning m.id, m.cancel

-- mq.mq.expire-gate
update "pgprime_mq"."queues" set expire_at = now() where name = $1 and expire_at <= now() - $2::float8 * interval '1 ms' returning 1

-- mq.mq.lock-ancestors
with recursive a(id, parent, on_fail, depth) as ( select id, parent, on_fail, 0 from "pgprime_mq"."messages" where id = $1::bigint union all select m.id, m.parent, m.on_fail, a.depth + 1 from "pgprime_mq"."messages" m join a on m.id = a.parent where a.on_fail = 'fail' ) select m.id from "pgprime_mq"."messages" m join a on a.id = m.id where a.depth > 0 order by a.depth for update of m

-- mq.mq.progress
with up as (update "pgprime_mq"."messages" m set progress = $1::jsonb where m.id = $2::bigint and m.token = $3 and m.state = 'active' returning m.id, m.queue, m.state), up_ev as (select pg_notify(('ev_' || left(encode(sha256(convert_to($4::text || (up.queue)::text, 'UTF8')), 'hex'), 24)), json_build_object('id', up.id::text, 's', up.state)::text) from up join "pgprime_mq"."queues" wq on wq.name = up.queue where wq.watch and true) select up.id, (select count(*) from up_ev) as fx from up

-- mq.mq.extend
update "pgprime_mq"."messages" set lease_until = now() + $1::float8 * interval '1 ms' where id = $2::bigint and token = $3 and state = 'active' returning id

-- mq.mq.dedup
select key, msg from "pgprime_mq"."dedup" where queue = $1 and key = any($2::text[])

-- mq.mq.queue
insert into "pgprime_mq"."queues" as u (name, rate_max, rate_ms, concurrency, keep_completed_ms, keep_completed_n, keep_failed_ms, keep_failed_n, watch) values ($1, $2::int, $3::int, $4::int, $5::bigint, $6::int, $7::bigint, $8::int, $9) on conflict (name) do update set rate_max = excluded.rate_max, rate_ms = excluded.rate_ms, concurrency = excluded.concurrency, keep_completed_ms = excluded.keep_completed_ms, keep_completed_n = excluded.keep_completed_n, keep_failed_ms = excluded.keep_failed_ms, keep_failed_n = excluded.keep_failed_n, watch = excluded.watch, limited_until = case when excluded.rate_max is null then null else u.limited_until end

-- mq.mq.pause
update "pgprime_mq"."queues" set paused = $1 where name = $2

-- mq.mq.cancel
update "pgprime_mq"."messages" set cancel = true, error = coalesce($1::text, error) where id = $2::bigint and queue = $3 and state = 'active' returning id

-- mq.mq.retry-check
select m.id from "pgprime_mq"."messages" m where m.queue = $1 and m.id = any($2::bigint[]) and m.state in ('completed', 'failed', 'cancelled') and exists (select from "pgprime_mq"."deps" d where d.parent = m.id and d.status in ('pending', 'failed'))

-- mq.mq.remove-lock
with recursive tree(id) as ( select id from "pgprime_mq"."messages" where id = $1::bigint and queue = $2 union all select m.id from "pgprime_mq"."messages" m join tree on m.parent = tree.id ), locked as ( select m.id, m.state, m.parent from "pgprime_mq"."messages" m where m.id in (select id from tree) for update skip locked ) select (select count(*)::int from tree) as total, l.id, l.state::text as state, l.parent from (select) x left join locked l on true

-- mq.mq.remove
with del as ( delete from "pgprime_mq"."messages" where id = any($1::bigint[]) returning id, queue, dedup_key ), dd as ( delete from "pgprime_mq"."dedup" x using del where x.queue = del.queue and x.key = del.dedup_key and x.msg = del.id and x.expire_at is null ) select count(*)::int as n from del

-- mq.mq.remove-parent
with done as (select $1::bigint as id, $2::bigint as parent, 'cancelled'::text as state, 'ignore'::text as on_fail), dp as (update "pgprime_mq"."deps" d set status = (case when done.state = 'completed' then 'completed' when done.on_fail = 'ignore' then 'ignored' else 'failed' end)::"pgprime_mq"."dep_status", value = $3::jsonb from done where d.parent = done.parent and d.child = done.id and d.status = 'pending' returning d.parent, d.status, done.on_fail), pr as (update "pgprime_mq"."messages" p set pending_deps = p.pending_deps - case when dp.status = 'failed' then 0 else 1 end, child_failed = p.child_failed or dp.status = 'failed', state = case when dp.status <> 'failed' and p.pending_deps = 1 and p.state = 'blocked' then 'ready'::"pgprime_mq"."msg_state" else p.state end, order_key = case when dp.status <> 'failed' and p.pending_deps = 1 and p.state = 'blocked' then sign(p.order_key) * nextval($4::regclass) else p.order_key end from dp where p.id = dp.parent and (dp.status <> 'failed' or dp.on_fail = 'fail') returning p.id, p.queue, p.state, dp.status = 'failed' as cascade), pr_wk as (select pg_notify(('ev_' || left(encode(sha256(convert_to($5::text || (w.queue)::text, 'UTF8')), 'hex'), 24)), 'w') from (select distinct queue from pr where state = 'ready') w), pr_ev as (select pg_notify(('ev_' || left(encode(sha256(convert_to($6::text || (pr.queue)::text, 'UTF8')), 'hex'), 24)), json_build_object('id', pr.id::text, 's', pr.state)::text) from pr join "pgprime_mq"."queues" wq on wq.name = pr.queue where wq.watch and pr.state = 'ready' and not pr.cascade) select (select count(*) from pr_wk) + (select count(*) from pr_ev) as fx

-- mq.mq.purge
with del as ( delete from "pgprime_mq"."messages" where id in ( select id from "pgprime_mq"."messages" where queue = $1 and ($2::text[] is null or state::text = any($3::text[])) and ($4::float8 is null or coalesce(finished_at, created_at) < now() - $5::float8 * interval '1 ms') limit 1000 for update skip locked) returning id, queue, dedup_key ), dd as ( delete from "pgprime_mq"."dedup" x using del where x.queue = del.queue and x.key = del.dedup_key and x.msg = del.id and x.expire_at is null ) select count(*)::int as n from del

-- mq.mq.active
select count(*)::int as n from "pgprime_mq"."messages" where queue = $1 and state = 'active'

-- mq.mq.drop
with g as (delete from "pgprime_mq"."groups" where queue = $1), d as (delete from "pgprime_mq"."dedup" where queue = $2) delete from "pgprime_mq"."queues" where name = $3

-- mq.mq.group
insert into "pgprime_mq"."groups" as r (queue, key, paused, concurrency, rate_max, rate_ms) values ($1, $2, $3, $4::int, $5::int, $6::int) on conflict (queue, key) do update set paused = r.paused, concurrency = excluded.concurrency, rate_max = r.rate_max, rate_ms = r.rate_ms

-- mq.mq.maintain
update "pgprime_mq"."queues" set maint_at = now() where name = $1 and maint_at <= now() - $2::float8 * interval '1 ms' returning keep_completed_n, keep_failed_n, concurrency is not null as counted

-- mq.mq.retention
with del as ( delete from "pgprime_mq"."messages" where id in ( select id from "pgprime_mq"."messages" where expire_at <= now() and state in ('completed', 'failed', 'cancelled') limit 1000 for update skip locked) returning 1 ) select count(*)::int as n from del

-- mq.mq.retention-count
with del as ( delete from "pgprime_mq"."messages" where id in ( select id from "pgprime_mq"."messages" where queue = $1 and state in ('completed') order by finished_at desc offset $2::int limit 1000 for update skip locked) returning 1 ) select count(*)::int as n from del

-- mq.mq.retention-count
with del as ( delete from "pgprime_mq"."messages" where id in ( select id from "pgprime_mq"."messages" where queue = $1 and state in ('failed', 'cancelled') order by finished_at desc offset $2::int limit 1000 for update skip locked) returning 1 ) select count(*)::int as n from del

-- mq.mq.dedup-expire
with del as ( delete from "pgprime_mq"."dedup" where (queue, key) in ( select queue, key from "pgprime_mq"."dedup" where expire_at <= now() limit 1000 for update skip locked) returning 1 ) select count(*)::int as n from del

-- mq.mq.reconcile-lock
select 1 from "pgprime_mq"."queues" where name = $1 for update

-- mq.mq.reconcile
update "pgprime_mq"."queues" set active = c.n from (select count(*)::int as n from "pgprime_mq"."messages" where queue = $1 and state = 'active' and counted) c where name = $2 and active <> c.n

-- mq.mq.get
select m.id, m.queue, m.state, m.payload, m.key, m.priority, m.order_key, m.run_at, m.group_key, m.attempts, m.claims, m.retry, m.token, m.progress, m.result, m.error, m.parent, m.on_fail, m.pending_deps, m.cancel, m.child_failed, m.created_at, m.started_at, m.finished_at from "pgprime_mq"."messages" m where queue = $1 and key = $2 order by id desc limit 1

-- mq.mq.get
select m.id, m.queue, m.state, m.payload, m.key, m.priority, m.order_key, m.run_at, m.group_key, m.attempts, m.claims, m.retry, m.token, m.progress, m.result, m.error, m.parent, m.on_fail, m.pending_deps, m.cancel, m.child_failed, m.created_at, m.started_at, m.finished_at from "pgprime_mq"."messages" m where id = $1::bigint

-- mq.mq.list
select m.id, m.queue, m.state, m.payload, m.key, m.priority, m.order_key, m.run_at, m.group_key, m.attempts, m.claims, m.retry, m.token, m.progress, m.result, m.error, m.parent, m.on_fail, m.pending_deps, m.cancel, m.child_failed, m.created_at, m.started_at, m.finished_at from "pgprime_mq"."messages" m where queue = $1 and id > $2::bigint and ($3::text[] is null or state::text = any($4::text[])) order by id limit $5::int

-- mq.mq.counts
select state::text as state, count(*)::int as n from "pgprime_mq"."messages" where queue = $1 group by state

-- mq.mq.child-results
select child, child_queue, status::text as status, value from "pgprime_mq"."deps" where parent = $1::bigint order by child

-- mq.mq.holder
select state, token, child_failed, pending_deps from "pgprime_mq"."messages" where id = $1::bigint

-- mq.mq.reconcile-lock
select key from "pgprime_mq"."groups" where queue = $1 and active <> 0 order by key limit 500 for update skip locked

-- mq.mq.reconcile
update "pgprime_mq"."groups" g set active = c.n from (select k.key, (select count(*)::int from "pgprime_mq"."messages" m where m.queue = $1 and m.group_key = k.key and m.state = 'active') as n from unnest($2::text[]) as k(key)) c where g.queue = $3 and g.key = c.key and g.active <> c.n"
`;
