-- send
with src as (select nextval($1::regclass) as id, r.* from rows from (jsonb_to_recordset($2::jsonb) as ( n int, queue text, parent_n int, kids int, on_fail text, payload jsonb, key text, priority int, lifo boolean, delay_ms float8, run_at timestamptz, group_key text, retry jsonb, dedup text, dedup_ms float8)) r order by r.n), ins as (insert into "pgprime_mq"."messages" (id, queue, state, payload, key, priority, order_key, run_at, group_key, retry, dedup_key, parent, on_fail, pending_deps) select s.id, s.queue, (case when s.kids > 0 then 'blocked' when s.at > now() then 'delayed' else 'ready' end)::"pgprime_mq"."msg_state", coalesce(s.payload, 'null'::jsonb), s.key, s.priority, case when s.lifo then -s.id else s.id end, case when s.kids = 0 and s.at > now() then s.at end, s.group_key, s.retry, s.dedup, p.id, s.on_fail::"pgprime_mq"."on_fail", s.kids from (select src.*, coalesce(run_at, now() + delay_ms * interval '1 ms') as at from src) s left join src p on p.n = s.parent_n where true returning id, queue, state, group_key, parent), dps as (insert into "pgprime_mq"."deps" (parent, child, child_queue) select parent, id, queue from ins where parent is not null), grp as (insert into "pgprime_mq"."groups" (queue, key) select distinct queue, group_key from ins where group_key is not null on conflict do nothing), ins_wk as (select pg_notify(('ev_' || left(encode(sha256(convert_to($3::text || (w.queue)::text, 'UTF8')), 'hex'), 24)), 'w') from (select distinct queue from ins where state <> 'blocked') w), ins_ev as (select pg_notify(('ev_' || left(encode(sha256(convert_to($4::text || (ins.queue)::text, 'UTF8')), 'hex'), 24)), json_build_object('id', ins.id::text, 's', ins.state)::text) from ins join "pgprime_mq"."queues" wq on wq.name = ins.queue where wq.watch and true) select src.n, ins.id, null::bigint as existing, (select count(*) from ins_wk) + (select count(*) from ins_ev) as fx from src left join ins on ins.id = src.id order by src.n

-- send dedup
with src as (select nextval($1::regclass) as id, r.* from rows from (jsonb_to_recordset($2::jsonb) as ( n int, queue text, parent_n int, kids int, on_fail text, payload jsonb, key text, priority int, lifo boolean, delay_ms float8, run_at timestamptz, group_key text, retry jsonb, dedup text, dedup_ms float8)) r order by r.n), d as (insert into "pgprime_mq"."dedup" as x (queue, key, msg, expire_at) select queue, dedup, id, now() + dedup_ms * interval '1 ms' from src where dedup is not null on conflict (queue, key) do update set msg = case when x.expire_at <= now() then excluded.msg else x.msg end, expire_at = excluded.expire_at where x.expire_at <= now() or (excluded.expire_at is not null and $3::boolean) returning key, msg), ins as (insert into "pgprime_mq"."messages" (id, queue, state, payload, key, priority, order_key, run_at, group_key, retry, dedup_key, parent, on_fail, pending_deps) select s.id, s.queue, (case when s.kids > 0 then 'blocked' when s.at > now() then 'delayed' else 'ready' end)::"pgprime_mq"."msg_state", coalesce(s.payload, 'null'::jsonb), s.key, s.priority, case when s.lifo then -s.id else s.id end, case when s.kids = 0 and s.at > now() then s.at end, s.group_key, s.retry, s.dedup, p.id, s.on_fail::"pgprime_mq"."on_fail", s.kids from (select src.*, coalesce(run_at, now() + delay_ms * interval '1 ms') as at from src) s left join src p on p.n = s.parent_n where true and (s.dedup is null or exists (select from d where d.key = s.dedup and d.msg = s.id)) returning id, queue, state, group_key, parent), dps as (insert into "pgprime_mq"."deps" (parent, child, child_queue) select parent, id, queue from ins where parent is not null), grp as (insert into "pgprime_mq"."groups" (queue, key) select distinct queue, group_key from ins where group_key is not null on conflict do nothing), ins_wk as (select pg_notify(('ev_' || left(encode(sha256(convert_to($4::text || (w.queue)::text, 'UTF8')), 'hex'), 24)), 'w') from (select distinct queue from ins where state <> 'blocked') w), ins_ev as (select pg_notify(('ev_' || left(encode(sha256(convert_to($5::text || (ins.queue)::text, 'UTF8')), 'hex'), 24)), json_build_object('id', ins.id::text, 's', ins.state)::text) from ins join "pgprime_mq"."queues" wq on wq.name = ins.queue where wq.watch and true) select src.n, ins.id, d.msg as existing, (select count(*) from ins_wk) + (select count(*) from ins_ev) as fx from src left join ins on ins.id = src.id left join d on d.key = src.dedup and d.msg <> src.id order by src.n

-- send debounce
with src as (select nextval($1::regclass) as id, r.* from rows from (jsonb_to_recordset($2::jsonb) as ( n int, queue text, parent_n int, kids int, on_fail text, payload jsonb, key text, priority int, lifo boolean, delay_ms float8, run_at timestamptz, group_key text, retry jsonb, dedup text, dedup_ms float8)) r order by r.n), d as (insert into "pgprime_mq"."dedup" as x (queue, key, msg, expire_at) select queue, dedup, id, now() + dedup_ms * interval '1 ms' from src where dedup is not null on conflict (queue, key) do update set msg = case when x.expire_at <= now() then excluded.msg else x.msg end, expire_at = excluded.expire_at where x.expire_at <= now() or (excluded.expire_at is not null and $3::boolean) returning key, msg), ins as (insert into "pgprime_mq"."messages" (id, queue, state, payload, key, priority, order_key, run_at, group_key, retry, dedup_key, parent, on_fail, pending_deps) select s.id, s.queue, (case when s.kids > 0 then 'blocked' when s.at > now() then 'delayed' else 'ready' end)::"pgprime_mq"."msg_state", coalesce(s.payload, 'null'::jsonb), s.key, s.priority, case when s.lifo then -s.id else s.id end, case when s.kids = 0 and s.at > now() then s.at end, s.group_key, s.retry, s.dedup, p.id, s.on_fail::"pgprime_mq"."on_fail", s.kids from (select src.*, coalesce(run_at, now() + delay_ms * interval '1 ms') as at from src) s left join src p on p.n = s.parent_n where true and (s.dedup is null or exists (select from d where d.key = s.dedup and d.msg = s.id)) returning id, queue, state, group_key, parent), dps as (insert into "pgprime_mq"."deps" (parent, child, child_queue) select parent, id, queue from ins where parent is not null), grp as (insert into "pgprime_mq"."groups" (queue, key) select distinct queue, group_key from ins where group_key is not null on conflict do nothing), ins_wk as (select pg_notify(('ev_' || left(encode(sha256(convert_to($4::text || (w.queue)::text, 'UTF8')), 'hex'), 24)), 'w') from (select distinct queue from ins where state <> 'b