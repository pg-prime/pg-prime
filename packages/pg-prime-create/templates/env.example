# Copy to .env. `pg-prime.config.ts` and `db.ts` both read DATABASE_URL, and the value below is
# the fallback pg-prime.config.ts uses when it is unset.
#
# `npm start` passes --env-file-if-exists=.env to node. The `pg-prime` CLI does not read .env, so
# either export the variable or run it as `node --env-file=.env node_modules/.bin/pg-prime …`.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
