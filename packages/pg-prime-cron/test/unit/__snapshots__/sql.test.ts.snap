// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`statement goldens > F1 1`] = `"with f as ( update "pgprime_cron"."runs" set state = $1::"pgprime_cron"."run_state", finished_at = clock_timestamp(), error = $2::text, result = $3::jsonb, attempts = $4::int, token = null, lease_until = null where id = $5::bigint and token = $6::text and state in ('running', 'cancelling') returning schedule ) update "pgprime_cron"."schedules" x set running = x.running - 1 from f where x.name = f.schedule returning 1 as ok"`;

exports[`statement goldens > K1 enqueued 1`] = `"with s as ( select name, overlap, running from "pgprime_cron"."schedules" where name = $1 and next_at = $2::timestamptz and enabled and not paused for update ), d as ( select name, case when $3::text is not null then $4::text when running = 0 or overlap = 'allow' then 'running' else 'skipped' end as st from s ), r as ( insert into "pgprime_cron"."runs" (schedule, tick_at, state, missed, token, lease_until, instance, started_at, finished_at, payload) select d.name, $5::timestamptz, d.st::"pgprime_cron"."run_state", $6::int, case when d.st = 'running' then gen_random_uuid()::text end, case when d.st = 'running' then now() + ($7::float8 * interval '1 ms') end, $8::text, case when d.st = 'running' then clock_timestamp() end, case when d.st in ('skipped', 'missed') then clock_timestamp() end, $9::jsonb from d on conflict (schedule, tick_at) where not manual do nothing returning id, state::text as state, token, payload ), u as ( update "pgprime_cron"."schedules" x set next_at = $10::timestamptz, updated_at = now(), runs = x.runs + (select count(*) from r), running = x.running + (select count(*) from r where state = 'running') from d where x.name = d.name ) select id, state, token, payload from r"`;

exports[`statement goldens > K1 handler 1`] = `"with s as ( select name, overlap, running from "pgprime_cron"."schedules" where name = $1 and next_at = $2::timestamptz and enabled and not paused for update ), d as ( select name, case when $3::text is not null then $4::text when running = 0 or overlap = 'allow' then 'running' else 'skipped' end as st from s ), r as ( insert into "pgprime_cron"."runs" (schedule, tick_at, state, missed, token, lease_until, instance, started_at, finished_at, payload) select d.name, $5::timestamptz, d.st::"pgprime_cron"."run_state", $6::int, case when d.st = 'running' then gen_random_uuid()::text end, case when d.st = 'running' then now() + ($7::float8 * interval '1 ms') end, $8::text, case when d.st = 'running' then clock_timestamp() end, case when d.st in ('skipped', 'missed') then clock_timestamp() end, $9::jsonb from d on conflict (schedule, tick_at) where not manual do nothing returning id, state::text as state, token, payload ), u as ( update "pgprime_cron"."schedules" x set next_at = $10::timestamptz, updated_at = now(), runs = x.runs + (select count(*) from r), running = x.running + (select count(*) from r where state = 'running') from d where x.name = d.name ) select id, state, token, payload from r"`;

exports[`statement goldens > K1 missed 1`] = `"with s as ( select name, overlap, running from "pgprime_cron"."schedules" where name = $1 and next_at = $2::timestamptz and enabled and not paused for update ), d as ( select name, case when $3::text is not null then $4::text when running = 0 or overlap = 'allow' then 'running' else 'skipped' end as st from s ), r as ( insert into "pgprime_cron"."runs" (schedule, tick_at, state, missed, token, lease_until, instance, started_at, finished_at, payload) select d.name, $5::timestamptz, d.st::"pgprime_cron"."run_state", $6::int, case when d.st = 'running' then gen_random_uuid()::text end, case when d.st = 'running' then now() + ($7::float8 * interval '1 ms') end, $8::text, case when d.st = 'running' then clock_timestamp() end, case when d.st in ('skipped', 'missed') then clock_timestamp() end, $9::jsonb from d on conflict (schedule, tick_at) where not manual do nothing returning id, state::text as state, token, payload ), u as ( update "pgprime_cron"."schedules" x set next_at = $10::timestamptz, updated_at = now(), runs = x.runs + (select count(*) from r), running = x.running + (select count(*) from r where state = 'running') from d where x.name = d.name ) select id, state, token, payload from r"`;

exports[`statement goldens > Q1 1`] = `"select name, next_at, pattern, every_ms::float8 as every_ms, at, tz, start_at, anchor_at, end_at, max_runs, runs, overlap, misfire, misfire_grace_ms, target, payload, timeout_ms, retry, now() as db_now from "pgprime_cron"."schedules" where enabled and not paused and next_at <= now() and name = any($1::text[]) order by next_at limit 100"`;

exports[`statement goldens > T1 1`] = `"with s as ( select name, overlap, running, payload from "pgprime_cron"."schedules" where name = $1 and target = 'handler' for update ), d as ( select name, payload, case when running = 0 or overlap = 'allow' then 'pending' else 'skipped' end as st from s ), r as ( insert into "pgprime_cron"."runs" (schedule, manual, state, instance, finished_at, payload) select name, true, st::"pgprime_cron"."run_state", $2::text, case when st = 'skipped' then clock_timestamp() end, coalesce($3::jsonb, payload) from d returning id, state::text as state ), u as ( update "pgprime_cron"."schedules" x set running = x.running + (select count(*) from r where state = 'pending') from d where x.name = d.name ), n as ( select pg_notify($4, $5) from r where state = 'pending' ) select id, state from r where (select count(*) from n) >= 0"`;

exports[`statement goldens > T2 1`] = `"with p as ( select id from "pgprime_cron"."runs" where state = 'pending' and schedule = any($1::text[]) order by id limit $2::int for update skip locked ) update "pgprime_cron"."runs" r set state = 'running', token = gen_random_uuid()::text, lease_until = now() + ($3::float8 * interval '1 ms'), instance = $4::text, started_at = clock_timestamp() from p, "pgprime_cron"."schedules" s where r.id = p.id and s.name = r.schedule returning r.id, r.schedule, r.tick_at, r.manual, r.missed, r.payload, r.token, s.timeout_ms, s.retry"`;

exports[`statement goldens > advance 1`] = `"update "pgprime_cron"."schedules" set next_at = $1::timestamptz, updated_at = now() where name = $2 and next_at = $3::timestamptz"`;

exports[`statement goldens > api insert 1`] = `"insert into "pgprime_cron"."schedules" as x (name, pattern, every_ms, at, tz, start_at, end_at, max_runs, overlap, misfire, misfire_grace_ms, target, queue, payload, timeout_ms, retry, keep_runs, keep_runs_ms, source, spec_hash, next_at, anchor_at) values ($1::text, $2::text, $3::bigint, $4::timestamptz, $5::text, $6::timestamptz, $7::timestamptz, $8::int, $9::text, $10::text, $11::int, $12::text, $13::text, $14::jsonb, $15::int, $16::jsonb, $17::int, $18::bigint, $19::text, $20::text, $21::timestamptz, $22::timestamptz) on conflict (name) do nothing returning name"`;

exports[`statement goldens > heartbeat 1`] = `"update "pgprime_cron"."runs" r set lease_until = now() + ($1::float8 * interval '1 ms') from unnest($2::bigint[], $3::text[]) h (id, tok) where r.id = h.id and r.token = h.tok and r.state in ('running', 'cancelling') returning r.id, r.state::text as state"`;

exports[`statement goldens > maintenance expire 1`] = `"with e as ( select id from "pgprime_cron"."runs" where state in ('running', 'cancelling') and lease_until < now() order by lease_until limit 500 for update skip locked ), f as ( update "pgprime_cron"."runs" r set state = (case when r.state = 'cancelling' then 'cancelled' else 'failed' end)::"pgprime_cron"."run_state", error = 'lease-expired', finished_at = clock_timestamp(), token = null, lease_until = null from e where r.id = e.id returning r.schedule ), c as ( select schedule, count(*) as n from f group by schedule ) update "pgprime_cron"."schedules" x set running = x.running - c.n from c where x.name = c.schedule returning x.name"`;

exports[`statement goldens > maintenance gate 1`] = `"update "pgprime_cron"."meta" set maint_at = now() where maint_at <= now() - ($1::float8 * interval '1 ms') returning 1 as ok"`;

exports[`statement goldens > maintenance retain 1`] = `"delete from "pgprime_cron"."runs" where id in ( select x.id from "pgprime_cron"."schedules" s cross join lateral ( select r.id from "pgprime_cron"."runs" r where r.schedule = s.name and r.state not in ('pending', 'running', 'cancelling') and (r.created_at < now() - s.keep_runs_ms * interval '1 ms' or r.id <= (select h.id from "pgprime_cron"."runs" h where h.schedule = s.name order by h.id desc offset s.keep_runs limit 1)) limit 1000 ) x limit 1000 )"`;

exports[`statement goldens > maintenance unclaimed 1`] = `"select count(*)::int as n from "pgprime_cron"."runs" where state = 'pending' and created_at < now() - ($1::float8 * interval '1 ms')"`;

exports[`statement goldens > markCancelling 1`] = `"update "pgprime_cron"."runs" set state = 'cancelling' where id = $1::bigint and token = $2::text and state = 'running'"`;

exports[`statement goldens > remove 1`] = `"with d as ( delete from "pgprime_cron"."schedules" where name = $1 and ($2::boolean or not exists (select 1 from "pgprime_cron"."runs" where schedule = $3 and state in ('pending', 'running', 'cancelling'))) returning 1 ) select (select count(*)::int from d) as deleted, (select count(*)::int from "pgprime_cron"."schedules" where name = $4) as present"`;

exports[`statement goldens > sync upsert 1`] = `"insert into "pgprime_cron"."schedules" as x (name, pattern, every_ms, at, tz, start_at, end_at, max_runs, overlap, misfire, misfire_grace_ms, target, queue, payload, timeout_ms, retry, keep_runs, keep_runs_ms, source, spec_hash, next_at, anchor_at) values ($1::text, $2::text, $3::bigint, $4::timestamptz, $5::text, $6::timestamptz, $7::timestamptz, $8::int, $9::text, $10::text, $11::int, $12::text, $13::text, $14::jsonb, $15::int, $16::jsonb, $17::int, $18::bigint, $19::text, $20::text, $21::timestamptz, $22::timestamptz) on conflict (name) do update set pattern = excluded.pattern, every_ms = excluded.every_ms, at = excluded.at, tz = excluded.tz, start_at = excluded.start_at, end_at = excluded.end_at, max_runs = excluded.max_runs, overlap = excluded.overlap, misfire = excluded.misfire, misfire_grace_ms = excluded.misfire_grace_ms, target = excluded.target, queue = excluded.queue, payload = excluded.payload, timeout_ms = excluded.timeout_ms, retry = excluded.retry, keep_runs = excluded.keep_runs, keep_runs_ms = excluded.keep_runs_ms, source = excluded.source, spec_hash = excluded.spec_hash, updated_at = now(), anchor_at = case when (x.pattern, x.every_ms, x.at, x.tz, x.start_at, x.end_at, x.max_runs) is distinct from (excluded.pattern, excluded.every_ms, excluded.at, excluded.tz, excluded.start_at, excluded.end_at, excluded.max_runs) then excluded.anchor_at else x.anchor_at end, next_at = case when not x.enabled then null when not (x.pattern, x.every_ms, x.at, x.tz, x.start_at, x.end_at, x.max_runs) is distinct from (excluded.pattern, excluded.every_ms, excluded.at, excluded.tz, excluded.start_at, excluded.end_at, excluded.max_runs) then x.next_at when x.runs >= excluded.max_runs then null else excluded.next_at end where x.spec_hash <> excluded.spec_hash returning name"`;

exports[`statement goldens > wakeIn 1`] = `"select extract(epoch from min(next_at) - now())::float8 * 1000 as ms from "pgprime_cron"."schedules" where enabled and not paused and next_at is not null and name = any($1::text[])"`;
