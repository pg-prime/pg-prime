{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "semi": false,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "objectWrap": "preserve",
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "fixtures/**",
    "tools/api-snapshot/**",
    // Markdown is not this formatter's job, and MDX is Markdown: oxfmt re-aligns every table to
    // its widest cell, which on a reference page of 300 rows makes an unreadable diff out of a
    // one-word edit. The docs site's TypeScript — `docs/src/snippets/**` and the fenced blocks,
    // which `tools/docs-typecheck.mjs` compiles — is checked by that gate instead.
    "**/*.md",
    "**/*.mdx",
    "**/*.probe.ts",
    "packages/pg-prime/test/query/types/**",
    "tools/type-errors/**",
    "packages/pg-prime/test/schema/audit.test.ts",
    "packages/pg-prime/test/sql/kysely-cve.test.ts",
    "packages/pg-prime/test/fuzz/builder-generator.ts",
    "packages/*/test/**/*.json",
    "**/__snapshots__/**",
    "**/*.snap",
    "bench/**/report.json",
    "packages/*/src/unsupported-typescript.d.ts"
  ],
  "overrides": [
    {
      "files": ["packages/pg-prime-kit/**"],
      "options": {
        "semi": true,
        "singleQuote": false,
        "printWidth": 120
      }
    }
  ]
}
